# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional: Backend Email Notification Provider API Key (e.g. Resend / SendGrid HTTP API)
# Used for sending payment-request notifications to official Ultron admins.
EMAIL_SERVICE_API_KEY=MY_EMAIL_SERVICE_API_KEY
EMAIL_FROM_ADDRESS=notifications@ultronstudy.app

# Spotify Web API Credentials (configure in AI Studio Secrets panel for live Spotify catalog search & playback)
SPOTIFY_CLIENT_ID=MY_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=MY_SPOTIFY_CLIENT_SECRET
SPOTIFY_ACCESS_TOKEN=MY_SPOTIFY_ACCESS_TOKEN
SPOTIFY_REFRESH_TOKEN=MY_SPOTIFY_REFRESH_TOKEN

